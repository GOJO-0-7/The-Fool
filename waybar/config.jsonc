{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": [
    "custom/arch",
    "hyprland/window",
    "cpu",
    "memory",
    "clock",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/audio-light",
    "group/tray-network",
    "group/stats",
    "custom/notification"
  ],
  // --- Module Groups ---
  "group/audio-light": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/bar",
      "pulseaudio",
      "backlight"
    ]
  },
  "group/tray-network": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "network"
    ]
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "battery",
      "temperature"
    ]
  },
  // --- Modules Configuration ---
  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "pkill rofi || ~/.config/rofi/scripts/launcher.sh"
  },
  "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 15,
    "rewrite": {
      " - ": "", // if no window is focused, a single dash is displayed, this removes it
      "(.*?) - Chromium - chromium": "   $1 ",
      "(.*chrome)...(.*)": "   $1 ",
      "(.*) - Obsidian - .* - obsidian": "   $1 ",
      "(.*nvim)...(.*)": "   $2 ",
      "(.*code) - (.*)": " 󰨞  $1 ",
      "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
      "^.*unimatrix( .*|$)": " 󰘨 MATRIX $1 ",
      "(.*) - Spotify": "  $1 ",
      "(.*) - com.mitchellh.ghostty": " 󰊠 $1 ",
      "(.*) - Alacritty": "   $1 ",
      "(.*) - kitty": "   $1 ",
      "(.*) - BeeperTexts": " 󰻞  $1 ",
      "(.*Discord)...(.*).. (.*)": "   $2 ",
      "(.*) - org.gnome.Nautilus": " 󰉓  $1 ",
      "(.*) - fish": "   [$1] ",
      "(.*Steam)...(.*)": "   $1",
      "(.*imv)...(.*).. (.*)": "   $2",
      "(.*) - com.obsproject.Studio": "  $1 "
    }
  },
  "cpu": {
    "format": "/ {icon} {usage}%",
    "format-icons": [
      "󰪞",
      "󰪟",
      "󰪠",
      "󰪡",
      "󰪢",
      "󰪣",
      "󰪤",
      "󰪥"
    ],
    "on-click": "kitty btop"
  },
  "memory": {
    "format": "/ {icon} {percentage}%",
    "format-icons": [
      "󰪞",
      "󰪟",
      "󰪠",
      "󰪡",
      "󰪢",
      "󰪣",
      "󰪤",
      "󰪥"
    ]
  },
  "clock": {
    "format": "  {:%I:%M %p}", // AM PM format
    //"format": "  {:%H:%M}",// 24H
    "format-alt": "{:%A  %e %B}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "mpris": {
    "interval": 10,
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {artist} {title}",
    "on-click-middle": "playerctl previous",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "scroll-step": 5.0,
    "on-scroll-up": "$HOME/.config/hypr/scripts/volume.sh --inc",
    "on-scroll-down": "$HOME/.config/hypr/scripts/volume.sh --dec",
    "smooth-scrolling-threshold": 1,
    "tooltip": true,
    "tooltip-format": "{status_icon} {dynamic}",
    "player-icons": {
      "chromium": "",
      "default": "",
      "firefox": "",
      "kdeconnect": "",
      "mopidy": "",
      "mpv": "󰐹",
      "spotify": "󰎆",
      "vlc": "󰕼"
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "dynamic-order": [
      "artist",
      "title"
    ],
    "max-length": 25
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "urgent": "", //---------"","●","○"--------------
      "active": "",
      "default": ""
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
    "persistent-workspaces": {
      "*": 1
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}% ",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": "󰅶 {icon} {format_source}",
    "format-muted": "  MUTED",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "pkill wiremix || kitty --class wiremix -e wiremix"
  },
  "backlight": {
    "format": "{icon} {percent}% ",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "scroll-step": 1,
    "tooltip": false
  },
  "tray": {
    "spacing": 12
  },
  "network": {
    "format": "{essid}",
    "format-wifi": "{essid}",
    "format-ethernet": "󱚻 {essid}",
    "format-disconnected": "󰌙",
    "tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}    ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} 󱚻",
    "tooltip-format-disconnected": "󰌙 NO NET BRUH",
    "max-length": 30,
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "kitty nmtui"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    }
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°C",
    "on-click": "pkill rofi || ~/.config/rofi/scripts/powermenu.sh"
  },
  "custom/notification": {
    "format": "{} ",
    "format-icons": {
      "notification": "<span font='8'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span font='8'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span font='8'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span font='8'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/bar": {
    "format": "||",
    "tooltip": false
  }
}
